# Tilbi subscription server

PORT=3001
APP_BASE_URL=http://localhost:3001
JWT_SECRET=change-me-to-a-long-random-string

# Stripe (card payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MONTHLY_PRICE_ID=price_...   # $5 / month
STRIPE_YEARLY_PRICE_ID=price_...    # $29 / year

# PayPal (subscriptions)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_MONTHLY_PLAN_ID=P-xxxxxxxx   # $5 / month
PAYPAL_YEARLY_PLAN_ID=P-xxxxxxxx    # $29 / year

# Database
DB_PATH=./data/tilbi.db
